# Porta do servidor (padrão 3000)
PORT=3000

# MySQL (banco do ERP BMsoft, tabelas lam_* do romaneio): HOST, USER e PASSWORD obrigatórios
MYSQL_HOST=
MYSQL_PORT=
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=bmerp_000000

# Chave que assina os tokens de sessão. Sem ela, uma chave aleatória é gerada a cada
# reinício do servidor e todos precisam entrar de novo.
SESSION_SECRET=

# Empresa usada quando o usuário (sys_usuarios.empresa_id) não tem empresa definida (padrão 1)
ID_EMPRESA=1

# Concluir romaneio com baixa de estoque: id da localização (cad_produtos_localizacoes) onde entram
# as lâminas e saem as toras. Obrigatória para concluir com "Baixar estoque" ligado.
ESTOQUE_LOCALIZACAO_ID=

# Botão "e-Mail" do romaneio: envio por SMTP. SMTP_SECURE=true para SSL direto (sem ela, só na 465)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_SECURE=
# Destinatário que já vem preenchido no envio do romaneio (opcional)
ROMANEIO_EMAIL_PARA=

# Gerar PDF fora da Vercel: caminho do Edge/Chrome (vazio = procura nos locais padrão)
NAVEGADOR_PDF=

# Gerar NFe do romaneio: endereço do BMNFe (concentrador de NF-e, projeto nfeWeb) e o usuário que o romaneio usa
# para entrar nele (login de /api/login, na empresa com o CNPJ de sys_empresas). A nota fica assinada
# no BMNFe, sem transmitir; o envio à SEFAZ é feito lá. Endereço sem http(s):// vale como https (ex.: nfe.bmsoft.com.br).
BMNFE_URL=
BMNFE_USUARIO=
BMNFE_SENHA=
